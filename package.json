{
	"name": "swupdate-lang",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"version": "1.0.2",
	"icon": "media/icon.png",
	"license": "MIT",
	"keywords": [
		"swupdate",
		"sw-description",
		"embedded linux",
		"firmware update",
		"OTA"
	],
	"publisher": "borkra",
	"repository": {
		"type": "git",
		"url": "https://github.com/borkra/swupdate-vscode-support"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionDependencies": [
		"borkra.libconfig-borkra"
	],
	"categories": [
		"Programming Languages"
	],
	"main": "./client/out/extension",
	"l10n": "./l10n",
	"contributes": {
		"languages": [
			{
				"id": "swupdate",
				"aliases": [
					"SWUpdate",
					"swupdate"
				],
				"filenames": [
					"sw-description"
				],
				"filenamePatterns": [
					"sw-description*"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "swupdate",
				"scopeName": "source.swupdate",
				"path": "./syntaxes/swupdate.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run extract-l10n && npm run bundle",
		"clean": "rm -rf client/out *.vsix client/tsconfig.tsbuildinfo",
		"clean:full": "npm run clean && rm -rf node_modules client/node_modules package-lock.json client/package-lock.json",
		"compile": "tsc -b",
		"bundle": "node scripts/bundle.js",
		"package:local": "npm run compile && npm run extract-l10n && npm run bundle && npx @vscode/vsce package --no-yarn --out swupdate-lang.vsix",
		"package:dev": "npm run compile && npm run extract-l10n && npm run bundle && npx @vscode/vsce package $(node scripts/dev-version.js) --no-yarn --out swupdate-lang.vsix --no-git-tag-version --no-update-package-json",
		"update:version": "node scripts/update-version.js",
		"version": "node scripts/update-version.js && git add client/package.json README.md",
		"watch": "tsc -b -w",
		"postinstall": "cd client && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh",
		"install:local": "npm run package:dev && node scripts/smart-reinstall.js",
		"sbom": "npm run sbom:cyclonedx && npm run sbom:spdx",
		"sbom:cyclonedx": "npx @cyclonedx/cdxgen -t javascript -o sbom.cdx.json",
		"sbom:spdx": "npx @cyclonedx/cdxgen -t javascript -o sbom.spdx.json --format spdx",
		"extract-l10n": "npx @vscode/l10n-dev export --outDir ./l10n './client/src/**/*.ts'"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"ovsx": "^1.0.1",
		"typescript": "^6.0.3"
	}
}
