{
	"name": "SWUpdate",
	"scopeName": "source.swupdate",
	"patterns": [
		{
			"include": "source.libconfig"
		}
	],
	"injectionSelector": "L:source.swupdate string.quoted.double.libconfig",
	"repository": {
		"swupdate-external-variable": {
			"match": "(@@)([^@]+)(@@)",
			"captures": {
				"1": {
					"name": "punctuation.definition.variable.begin.swupdate"
				},
				"2": {
					"name": "variable.other.external.swupdate"
				},
				"3": {
					"name": "punctuation.definition.variable.end.swupdate"
				}
			}
		},
		"swupdate-function": {
			"begin": "(\\$)([a-zA-Z_][a-zA-Z0-9_]*)(\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.variable.swupdate"
				},
				"2": {
					"name": "entity.name.function.swupdate"
				},
				"3": {
					"name": "punctuation.section.parens.begin.swupdate"
				}
			},
			"end": "(\\))",
			"endCaptures": {
				"1": {
					"name": "punctuation.section.parens.end.swupdate"
				}
			},
			"contentName": "variable.parameter.swupdate",
			"patterns": [
				{
					"include": "#swupdate-external-variable"
				}
			]
		}
	},
	"injections": {
		"L:source.swupdate string.quoted.double.libconfig": {
			"patterns": [
				{
					"include": "#swupdate-external-variable"
				},
				{
					"include": "#swupdate-function"
				}
			]
		}
	}
}
